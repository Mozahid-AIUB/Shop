{
  "name": "@shop/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types and Zod schemas between api and web",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.ts\""
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "files": [
    "dist"
  ]
}
