// Phase 01 — কঙ্কাল schema. Auth Phase 02-এ, কিন্তু migration pipeline আজই কাজ করা দরকার।
// পরের phase-গুলোতে Product, Design, Order ইত্যাদি model যোগ হবে।

generator client {
  provider = "prisma-client-js"
}

// connection URL prisma.config.ts-এ — Prisma 7-এ schema-তে `url` আর সাপোর্টেড নয়
datasource db {
  provider = "postgresql"
}

/// RBAC role — packages/shared/src/constants/roles.ts-এর সাথে হুবহু মিল থাকতে হবে
enum Role {
  SUPER_ADMIN
  ORDER_MANAGER
  DESIGNER
  ACCOUNTANT
  CUSTOMER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?  @unique
  name      String
  /// argon2 hash — কখনো plain text নয় (Phase 02)
  password  String
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens    RefreshToken[]
  cart             Cart?
  addresses        Address[]
  orders           Order[]
  /// এই staff যে পেমেন্টগুলো লিখেছে
  recordedPayments Payment[]
  /// এই staff যে status বদলগুলো করেছে
  statusChanges    OrderStatusHistory[]
  /// যে কাজগুলো এই staff-কে দেওয়া হয়েছে
  assignedTasks    ProductionTask[]     @relation("AssignedTasks")
  /// যে কাজগুলো এই staff তৈরি করেছে
  createdTasks     ProductionTask[]     @relation("CreatedTasks")
  /// অডিট লগে এই staff-এর কাজ
  activityLogs     ActivityLog[]

  /// কোন কুপন কতবার নিয়েছে — প্রতি-ইউজার সীমা এখান থেকে গোনা হয়
  couponRedemptions CouponRedemption[]

  @@index([role])
  @@map("users")
}

/// লগইন সেশন. কাঁচা টোকেন কখনো এখানে থাকবে না — শুধু sha256 hash,
/// যাতে DB লিক হলেও কারো সেশন হাইজ্যাক করা না যায়।
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  /// একটা লগইন থেকে জন্মানো সব টোকেনের একই familyId। rotate হলে নতুন row পায়
  /// কিন্তু family একই থাকে — মুছে ফেলা টোকেন আবার এলে এই family ধরেই চুরি ধরা পড়ে।
  familyId  String
  /// rotate হয়ে যাওয়া টোকেন সঙ্গে সঙ্গে মুছি না — ফিরে এলে যেন চিনতে পারি
  revokedAt DateTime?
  /// audit — কোন device/IP থেকে সেশনটা শুরু হয়েছিল
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// ক্যাটাগরি — সর্বোচ্চ দুই স্তর ("ইলেকট্রনিক্স > ফোন")।
/// গভীরতার নিয়ম DB নয়, service-এ প্রয়োগ হয়: parent-এর নিজের parent থাকলে বাতিল।
model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([parentId, sortOrder])
  @@map("categories")
}

/// যেকোনো ধরনের পণ্য। ধরনভেদে আলাদা ফিল্ড নয় —
/// যা আলাদা তা `ProductAttribute`-এ key-value হয়ে বসে।
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  categoryId  String
  /// খসড়া প্রোডাক্ট storefront-এ কোথাও দেখা যাবে না
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category           @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  attributes ProductAttribute[]

  /// storefront-এর প্রধান দুই query: ক্যাটাগরিভিত্তিক তালিকা আর নতুন পণ্য
  @@index([categoryId, isPublished])
  @@index([isPublished, createdAt])
  @@map("products")
}

/// বিক্রির আসল একক। দাম আর স্টক এখানে, Product-এ নয় —
/// কারণ একই শার্টের M আর XL-এর দাম ও স্টক আলাদা হতে পারে।
model ProductVariant {
  id                String  @id @default(cuid())
  productId         String
  sku               String  @unique
  /// paisa — ১০০ টাকা = 10000. float কখনো নয়
  pricePaisa        Int
  /// কাটার আগের দাম, ছাড় দেখাতে
  comparePricePaisa Int?
  stock             Int     @default(0)
  /// কুরিয়ারে পাঠানোর ওজন, **গ্রামে** (Phase 10)।
  ///
  /// গ্রাম, কেজি নয় — RedX গ্রামে চায়, Pathao কেজিতে। integer-এ
  /// রাখলে float-এর ভাঙা হিসাব এড়ানো যায়, আর adapter নিজের একক
  /// অনুযায়ী ভাগ করে নেয়। কুরিয়ার ওজন ধরে চার্জ করে, তাই ভুল ওজন
  /// মানে ভুল বিল।
  ///
  /// `null` = লেখা হয়নি; তখন কুরিয়ার সেটআপের ডিফল্ট ওজন যায়।
  weightGrams       Int?
  isActive          Boolean @default(true)

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options    VariantOption[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, isActive])
  @@map("product_variants")
}

/// "Color: Red", "Size: XL", "Storage: 256GB" — নাম হার্ডকোড নয়,
/// তাই জামা আর ফোন একই কাঠামোয় বসে।
model VariantOption {
  id        String @id @default(cuid())
  variantId String
  name      String
  value     String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, name])
  @@index([name, value])
  @@map("variant_options")
}

/// প্রোডাক্ট পর্যায়ের বৈশিষ্ট্য — "Fabric: Cotton", "Warranty: 1 year"।
model ProductAttribute {
  id        String @id @default(cuid())
  productId String
  name      String
  value     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@map("product_attributes")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// অর্ডারের জীবনচক্র — `packages/shared/src/constants/order.ts`-এর সাথে হুবহু মিল।
enum OrderStatus {
  PENDING
  DESIGN_CONFIRMED
  IN_PRODUCTION
  PRINTED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

/// টাকা কীভাবে এলো। `*_MANUAL` মানে কাস্টমার পাঠিয়েছে আর অ্যাডমিন
/// হাতে লিখে দিয়েছে — গেটওয়ের নিশ্চয়তা নেই, তাই `reference`-এ TrxID রাখা হয়।
enum PaymentMethod {
  COD
  BKASH_MANUAL
  NAGAD_MANUAL
  BANK_TRANSFER
  CASH
}

/// পেমেন্ট row-এর অবস্থা। ভুল এন্ট্রি **মুছে ফেলা হয় না** — VOIDED করা হয়,
/// নইলে টাকার হিসাবের অডিট ট্রেইল হারিয়ে যায়।
enum PaymentRecordStatus {
  RECEIVED
  VOIDED
  REFUNDED
}

/// কার্ট — লগইন করা ইউজারের, **নয়তো** গেস্টের।
///
/// ঠিক একটা মালিক থাকে: হয় `userId`, নয় `guestToken` — দুটোই নয়,
/// কোনোটাই নয় এমনও নয়। service সেটা নিশ্চিত করে।
///
/// **কেন গেস্ট cart দরকার:** বাংলাদেশে অনেক ক্রেতা অ্যাকাউন্ট খুলতে
/// চায় না। লগইন বাধ্যতামূলক রাখলে কিনতে আসা ক্রেতাও ফিরে যায়।
model Cart {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// গেস্টের পরিচয় — **সার্ভার তৈরি করে**, ক্লায়েন্ট নয়।
  /// ক্লায়েন্টকে বানাতে দিলে কেউ `guest-1`, `guest-2` পাঠিয়ে অন্যের
  /// কার্ট খুলে ফেলত। তাই অনুমান-অসাধ্য random মান।
  guestToken String? @unique

  items     CartItem[]
  updatedAt DateTime   @updatedAt

  /// পুরোনো গেস্ট cart পরিষ্কার করার জন্য (cron, পরে)
  @@index([guestToken, updatedAt])
  @@map("carts")
}

/// দাম এখানে রাখা হয় না — চেকআউটের সময় DB থেকে তাজা দাম পড়া হয়,
/// নইলে কার্টে পুরোনো দাম আটকে থাকত।
model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// একই variant দুবার থাকবে না — পরিমাণ বাড়বে
  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  district  String
  postcode  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId, isDefault])
  @@map("addresses")
}

/// অর্ডার। ঠিকানা আর দাম এখানে **কপি** করা থাকে —
/// ইউজার পরে ঠিকানা বদলালে বা পণ্যের দাম বদলালেও পুরোনো অর্ডার অবিকৃত থাকে।
model Order {
  id            String        @id @default(cuid())
  /// ORD-2026-1123-018 — পড়া ও ফোনে বলা সহজ
  orderNumber   String        @unique
  /// `null` মানে গেস্ট অর্ডার — অ্যাকাউন্ট ছাড়া দেওয়া।
  ///
  /// **সতর্কতা:** এটা nullable হওয়ায় `where: { userId }` আর
  /// ownership যাচাইয়ের জন্য যথেষ্ট নয় — `undefined` পাঠালে Prisma
  /// শর্তটাই বাদ দেয় আর সব অর্ডার ফেরত আসে। তাই service-এ
  /// `userId` সবসময় স্পষ্ট `string` হিসেবে পাঠানো হয়।
  userId        String?
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  /// সব টাকা integer paisa-তে
  subtotalPaisa         Int
  shippingPaisa         Int @default(0)
  /// পণ্যের দামে ছাড় (কুপন)
  discountPaisa         Int @default(0)
  /// ডেলিভারি চার্জে ছাড় — `FREE_SHIPPING` কুপনের জন্য **আলাদা মাঠ**।
  /// `discountPaisa`-তে মিশিয়ে দিলে ইনভয়েসে "ডেলিভারি ১২০৳" আর
  /// "ছাড় ১২০৳" দুটোই দেখাত, আর কুরিয়ারের বিলের সাথে হিসাব মেলানো
  /// কঠিন হতো। মোট = subtotal + shipping − discount − shippingDiscount
  shippingDiscountPaisa Int @default(0)
  totalPaisa            Int

  /// ডেলিভারির ঠিকানার স্ন্যাপশট
  addressId    String?
  shipFullName String
  shipPhone    String
  shipLine1    String
  shipLine2    String?
  shipCity     String
  shipDistrict String
  shipPostcode String?

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments        Shipment[]
  user             User?                @relation(fields: [userId], references: [id])
  address          Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  history          OrderStatusHistory[]
  payments         Payment[]
  tasks            ProductionTask[]
  /// COD ঝুঁকির হিসাব — checkout-এর সময় একবার
  fraudCheck       FraudCheck?
  /// কোন কুপন ব্যবহার হয়েছে — এক অর্ডারে সর্বোচ্চ একটা
  couponRedemption CouponRedemption?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

/// অর্ডারের সময়কার পণ্যের তথ্য কপি করা — variant পরে মুছে গেলেও
/// ইনভয়েসে কী কেনা হয়েছিল তা পড়া যাবে।
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  variantId String?

  productName String
  variantSku  String
  /// "Size: L, Color: Black" — অর্ডারের সময় যা ছিল
  optionsText String?

  unitPricePaisa Int
  quantity       Int
  lineTotalPaisa Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  /// কে বদলালো — null মানে সিস্টেম
  changedById String?
  note        String?
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// staff মুছে গেলেও ইতিহাস থাকবে — তাই SetNull, Cascade নয়
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// অর্ডারের একটা পেমেন্ট। অর্ডারপ্রতি **একাধিক** হতে পারে —
/// অগ্রিম ৫০০ + ডেলিভারিতে বাকিটা, এভাবে।
///
/// কত টাকা এসেছে তা এই row-গুলোর **যোগফল**, `Order`-এ জমানো কোনো
/// কলাম নয়। জমিয়ে রাখলে একটা এন্ট্রি ভুল হলে দুই জায়গায় ঠিক করতে হতো,
/// আর দুটো একসাথে ভুল হলে কোনটা সত্যি তা বোঝার উপায় থাকত না।
model Payment {
  id          String              @id @default(cuid())
  orderId     String
  /// ঋণাত্মক নয় — রিফান্ড আলাদা row, status দিয়ে চেনা যায়
  amountPaisa Int
  method      PaymentMethod
  status      PaymentRecordStatus @default(RECEIVED)

  /// বিকাশের TrxID, ব্যাংকের slip নম্বর — মেলানোর জন্য
  reference String?
  note      String?

  /// কে লিখলো। staff মুছে গেলেও row থাকবে, তাই SetNull
  recordedById String?
  recordedBy   User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  /// void করার কারণ — অডিটে "কেন বাতিল" প্রশ্নের উত্তর
  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// একই TrxID দুবার লেখা আটকায় — ভুল করে দুবার এন্ট্রি দিলে ধরা পড়ে
  @@unique([method, reference])
  @@index([orderId, createdAt])
  @@index([status])
  @@map("payments")
}

/// কাজের ধরন। ছাপা, প্যাকিং, QC — দোকান যেকোনো পণ্য বিক্রি করে,
/// তাই ধরনটা সাধারণ রাখা হয়েছে, ছাপার কাজে নির্দিষ্ট নয়।
enum ProductionTaskKind {
  DESIGN
  PRINT
  PACKING
  QC
  OTHER
}

/// কাজের অবস্থা। স্তর কম রাখা হলো ইচ্ছাকৃতভাবে — বেশি স্তর মানে
/// কর্মী আপডেট করা বন্ধ করে দেয় আর বোর্ড মিথ্যে বলতে শুরু করে।
enum ProductionTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
  CANCELLED
}

/// অর্ডারের একটা কাজ। এক অর্ডারে একাধিক — ছাপা একজন, প্যাকিং আরেকজন।
model ProductionTask {
  id      String               @id @default(cuid())
  orderId String
  kind    ProductionTaskKind
  status  ProductionTaskStatus @default(PENDING)

  /// null মানে এখনো কেউ নেয়নি — কাজ তৈরি আর বিলি আলাদা ঘটনা
  assignedToId String?
  /// staff মুছে গেলেও কাজ থাকবে, তাই SetNull
  assignedTo   User?   @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)

  note  String?
  dueAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([assignedToId, status])
  @@index([status, createdAt])
  @@map("production_tasks")
}

/// অ্যাডমিনের **লেখার** কাজের হিসাব — কে কখন কী বদলালো।
///
/// পড়ার কাজ ধরা হয় না; ধরলে এই টেবিলই সবচেয়ে বড় হয়ে যেত আর
/// আসল ঘটনা খুঁজে পাওয়া কঠিন হতো।
///
/// `OrderStatusHistory` থেকে আলাদা কারণ সেটা শুধু অর্ডারের status-এর
/// আর কাস্টমারকেও দেখানো হয়। এটা ভেতরের লোকের জন্য — এক টেবিলে
/// মেশালে কাস্টমারকে দেখানোর সময় একবার ছাঁকতে ভুললেই তথ্য ফাঁস।
model ActivityLog {
  id String @id @default(cuid())

  /// কে করলো — null মানে সিস্টেম (cron, webhook)
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// "order.status_changed", "payment.recorded" — ছাঁকার জন্য
  action String

  /// কোন জিনিসের উপর — "Order", "Payment", "Product"
  entityType String
  entityId   String

  /// মানুষের পড়ার মতো এক লাইন — "PENDING → DESIGN_CONFIRMED"
  summary String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}

/// দিনে দিনে অর্ডার নম্বরের সিরিয়াল।
/// এক দিনে একটাই row; `SELECT … FOR UPDATE` দিয়ে সেটা লক করে বাড়ানো হয়,
/// তাই একসাথে বহু চেকআউট এলেও দুটো অর্ডার একই নম্বর পায় না।
model OrderCounter {
  /// "2026-1123" — তারিখই চাবি
  dateKey    String @id
  lastSerial Int    @default(0)

  @@map("order_counters")
}

/// COD ঝুঁকির স্তর — `packages/shared/constants/fraud.ts`-এর সাথে মেলে।
enum FraudLevel {
  LOW
  MEDIUM
  HIGH
}

/// অর্ডারের সময়কার ঝুঁকির হিসাব।
///
/// **কেন অর্ডারের সাথে সংরক্ষণ করা হয়, প্রতিবার হিসাব নয়:** স্কোর
/// ওই মুহূর্তের তথ্যের উপর নির্ভর করে। পরে কাস্টমার আরও অর্ডার
/// করলে বা বাতিল করলে স্কোর বদলাবে — কিন্তু "তখন কেন পাঠানো
/// হয়েছিল" প্রশ্নের উত্তর তখনকার স্কোরেই আছে।
///
/// **কেন আলাদা `CustomerRiskProfile` নয়:** ঝুঁকি কাস্টমারের স্থায়ী
/// বৈশিষ্ট্য নয়, প্রতি অর্ডারের প্রসঙ্গে আলাদা (ছোট অর্ডার বনাম বড়)।
/// আলাদা profile রাখলে সেটা বাসি হয়ে যেত।
model FraudCheck {
  id      String     @id @default(cuid())
  orderId String     @unique
  score   Int
  level   FraudLevel

  /// কোন কোন কারণে এই স্কোর — ব্যাখ্যা ছাড়া সংখ্যা অর্থহীন,
  /// অ্যাডমিন জানবে না ফোনে কী জিজ্ঞেস করতে হবে
  reasons Json

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([level, createdAt])
  @@map("fraud_checks")
}

/// ডেলিভারি চার্জের এলাকা।
///
/// **কেন DB-তে, কোডে নয়:** এই কোড অন্য ব্যবসায়ীদের কাছে বিক্রি হবে।
/// প্রত্যেকের চার্জ, এলাকা আর ফ্রি ডেলিভারির সীমা আলাদা — কোডে
/// লিখলে প্রতিবার deploy লাগত।
model ShippingZone {
  id   String @id @default(cuid())
  /// "ঢাকা সিটি", "ঢাকার বাইরে" — কার্টে এই নামটাই দেখানো হয়
  name String

  /// কোন জেলাগুলো এই zone-এ। `Order.shipDistrict`-এর সাথে মেলানো হয়
  /// (ছোট-বড় হাতের পার্থক্য উপেক্ষা করে)।
  ///
  /// আলাদা table নয় কারণ ৬৪ জেলা স্থির, আর প্রতি quote-এ একটা join
  /// বাঁচে। নতুন এলাকা যোগ করতে শুধু এই array-তে নাম বসালেই হয়।
  districts String[]

  chargePaisa Int

  /// এই অঙ্কের সমান বা বেশি হলে ফ্রি। `null` মানে এই zone-এ কখনো ফ্রি নয়।
  /// zone-ভিত্তিক, কারণ ঢাকায় ১০০০+ ফ্রি দেওয়া যায়, বাইরে যায় না।
  freeAbovePaisa Int?

  /// কোনো জেলা না মিললে এই zone। **ঠিক একটা zone-এ `true` থাকতে হবে** —
  /// নইলে নতুন জেলার ক্রেতা শূন্য চার্জে ডেলিভারি পেয়ে যেত।
  /// `shipping.service.ts` এটা যাচাই করে।
  isDefault Boolean @default(false)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("shipping_zones")
}

/// কুপন কী ধরনের ছাড় দেয়।
enum DiscountType {
  /// শতাংশ — `value` ১০ মানে ১০%
  PERCENT
  /// নির্দিষ্ট অঙ্ক — `value` paisa-তে
  FIXED
  /// কুরিয়ার খরচ মাফ, পণ্যের দামে ছাড় নয়
  FREE_SHIPPING
}

/// ছাড়ের কুপন।
///
/// **কেন সব শর্ত DB-তে:** মালিকের চাওয়া "যখন যেমন ইচ্ছা তেমন অফার"।
/// অফারের নিয়ম কোডে লিখলে প্রতিটা নতুন ক্যাম্পেইনে deploy লাগত।
/// এখানে সব মাঠ অ্যাডমিন প্যানেল থেকে ঠিক করা যায়, তাই একই কোড দিয়ে
/// ঈদের ১০%, নির্দিষ্ট ২০০ টাকা, বা ফ্রি ডেলিভারি — সব চালানো যায়।
model Coupon {
  id          String  @id @default(cuid())
  /// "SAVE50" — সবসময় **বড় হাতে** সংরক্ষিত, কারণ ক্রেতা যেভাবেই
  /// টাইপ করুক একই কুপন খুঁজে পেতে হবে
  code        String  @unique
  /// অ্যাডমিনের নিজের জন্য নোট — "ঈদ ক্যাম্পেইন ২০২৬"
  description String?

  type  DiscountType
  /// `PERCENT`-এ শতাংশ, `FIXED`-এ paisa, `FREE_SHIPPING`-এ অব্যবহৃত
  value Int

  /// `PERCENT`-এর সর্বোচ্চ ছাড় — "১০% কিন্তু সর্বোচ্চ ২০০ টাকা"।
  /// বড় অর্ডারে অনিচ্ছাকৃত বড় ছাড় আটকায়। `null` = সীমা নেই
  maxDiscountPaisa Int?

  /// এর চেয়ে কম অর্ডারে কুপন চলবে না
  minOrderPaisa Int @default(0)

  /// মেয়াদ। `null` মানে ওই দিকে কোনো সীমা নেই
  startsAt DateTime?
  endsAt   DateTime?

  /// সব মিলিয়ে সর্বোচ্চ কতবার চলবে। `null` = সীমা নেই
  maxUses        Int?
  /// এক ক্রেতা কতবার। ডিফল্ট ১ — নইলে একজনই পুরো ক্যাম্পেইন খেয়ে ফেলত।
  ///
  /// `null` = প্রতি-ক্রেতা সীমা নেই। তখন কারো ব্যবহার গোনার দরকার না
  /// থাকায় কুপনটা **গেস্টও** পায়। সীমা বসালে কুপন লগইন করা ক্রেতার
  /// জন্য সংরক্ষিত হয়ে যায় — অ্যাডমিন ঠিক করবে কোনটা চায়।
  maxUsesPerUser Int? @default(1)

  /// ক্যাম্পেইন সাথে সাথে বন্ধ করার সুইচ — মেয়াদ বদলানোর দরকার নেই
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]

  /// সক্রিয় কুপনের তালিকা অ্যাডমিন প্যানেলে
  @@index([isActive, endsAt])
  @@map("coupons")
}

/// কে কখন কোন কুপন ব্যবহার করল।
///
/// **`Coupon.usedCount` রাখা হয় না** — সেটা দুই জায়গায় সত্য হতো, আর
/// অর্ডার বাতিল হলে বা গোনায় ভুল হলে দুটো আর মিলত না। ব্যবহারের
/// সংখ্যা সবসময় এই table থেকে গোনা হয়।
///
/// গোনা আর লেখা **একই transaction-এ** হয় (`coupon.service.ts`),
/// নইলে দুটো চেকআউট একই শেষ কুপন পেয়ে যেত।
model CouponRedemption {
  id       String  @id @default(cuid())
  couponId String
  /// `null` = গেস্ট অর্ডারে ব্যবহার হয়েছে।
  ///
  /// প্রতি-ক্রেতা সীমা গোনা হয় এই মাঠ ধরে, আর গেস্টের পরিচয় নেই।
  /// তাই গেস্ট শুধু সেই কুপনই পায় যার `maxUsesPerUser` `null` —
  /// মানে গোনার দরকার নেই এমন কুপন। তবু ব্যবহারটা লিখে রাখা হয়,
  /// কারণ অ্যাডমিনকে জানতে হবে ক্যাম্পেইনে মোট কত ছাড় গেল।
  userId   String?
  /// এক অর্ডারে একটাই কুপন — তাই `@unique`। এটাই race-এর আসল রক্ষা:
  /// একই অর্ডারে দুবার লেখার চেষ্টা DB-তেই আটকে যায়
  orderId  String @unique

  /// কত ছাড় পেল — পরে কুপনের মান বদলালেও এই অর্ডারের ইতিহাস ঠিক থাকে
  discountPaisa         Int
  /// ডেলিভারিতে কত ছাড় — `FREE_SHIPPING`-এর জন্য আলাদা
  shippingDiscountPaisa Int @default(0)

  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// একই কুপন একই অর্ডারে দুবার নয়
  @@unique([couponId, orderId])
  /// "এই ক্রেতা এই কুপন কতবার নিল" — প্রতি checkout-এ গোনা হয়
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

/// কোন কুরিয়ার। `MANUAL` = নিজের লোকে ডেলিভারি, কোনো API নেই
enum CourierKind {
  STEADFAST
  PATHAO
  REDX
  CARRYBEE
  MANUAL
}

/// পার্সেলের অবস্থা — কুরিয়ারের নিজের নাম এগুলোতে map হয়
enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

/// কুরিয়ারের সেটআপ — **সব অ্যাডমিন প্যানেল থেকে, `.env`-এ কিছু নয়**।
///
/// **কেন DB-তে, env-এ নয়:** এই কোড অন্য ব্যবসায়ীদের কাছেও যাবে।
/// key বদলাতে সার্ভারে SSH করে ফাইল এডিট করে রিস্টার্ট করতে হলে
/// তারা পারত না। প্যানেল থেকে বসানো যায় বলে চুক্তি হওয়ার দিনই
/// চালু করা যায়।
///
/// **একাধিক কুরিয়ার একসাথে** — ঢাকার ভেতরে এক কুরিয়ার, বাইরে
/// আরেকটা রেখে খরচ কমানো যায়, আর একটা বন্ধ থাকলেও কাজ আটকায় না।
model CourierAccount {
  id   String      @id @default(cuid())
  kind CourierKind @unique

  /// প্যানেলে দেখানোর নাম — "Steadfast (মূল)" ইত্যাদি
  label String

  /**
   * credential, **এনক্রিপ্ট করা JSON**।
   *
   * আলাদা কলাম নয় ইচ্ছাকৃতভাবে: চারটা কুরিয়ারের মাঠ একেবারে
   * আলাদা। Steadfast-এ api-key + secret-key, Pathao-তে OAuth-র
   * চারটা মান, RedX-এ একটা JWT, Carrybee-তে client id + secret +
   * context। আলাদা কলাম রাখলে অর্ধেক কলাম সবসময় `null` থাকত আর
   * নতুন কুরিয়ার যোগ করতে migration লাগত।
   *
   * `null` = এখনো key বসানো হয়নি (`MANUAL`-এ কখনো লাগে না)।
   */
  credentials String?

  /// বন্ধ রাখার সুইচ — key মুছতে হবে না, চুক্তি ফিরলে আবার চালু
  isActive Boolean @default(false)

  /// কিছু না বাছলে এটাই — ঠিক একটাই `true` থাকে, service নিশ্চিত করে
  isDefault Boolean @default(false)

  /// sandbox/test mode — আসল পার্সেল না পাঠিয়ে পরীক্ষা করা যায়
  isSandbox Boolean @default(false)

  /// পার্সেলের ডিফল্ট ওজন, **গ্রামে**।
  ///
  /// পণ্যে ওজন লেখা না থাকলে এটা যায়। কুরিয়াররা ওজন **বাধ্যতামূলক**
  /// চায় (Pathao-তে ন্যূনতম ০.৫ কেজি), তাই কিছু একটা পাঠাতেই হয় —
  /// আর ০ পাঠালে তারা পার্সেলই নিত না।
  ///
  /// ডিফল্ট ৫০০ গ্রাম: Pathao-র ন্যূনতম, আর টি-শার্ট/জামার জন্য
  /// বাস্তবসম্মত। ভারী পণ্য বিক্রি করলে অ্যাডমিন বাড়িয়ে নেবে।
  defaultWeightGrams Int @default(500)

  /**
   * webhook যাচাইয়ের গোপন মান, **এনক্রিপ্ট করা**।
   *
   * ছাড়া webhook খোলা দরজা: যে কেউ "DELIVERED" পাঠিয়ে অর্ডার
   * ডেলিভারড দেখাত, আর COD-র টাকা না পেয়েই হিসাব মিলে যেত।
   */
  webhookSecret String?
  /**
   * OAuth টোকেন, **এনক্রিপ্ট করা JSON** — Pathao-র মতো কুরিয়ারের জন্য।
   *
   * Pathao প্রতিটা কলে static key নেয় না; আগে টোকেন ইস্যু করতে হয়,
   * আর সেটার মেয়াদ ৫ দিন। প্রতিবার নতুন টোকেন চাইলে তাদের rate
   * limit-এ পড়তাম, আর মেমরিতে রাখলে সার্ভার রিস্টার্টেই হারাত —
   * একাধিক সার্ভার চালালে প্রত্যেকে আলাদা টোকেন নিত।
   *
   * আকার: `{ accessToken, refreshToken, expiresAt }`।
   *
   * **key-র মতোই এনক্রিপ্টেড**, কারণ টোকেন হাতে পেলে key-র মতোই
   * কাজ করা যায় — মেয়াদ শেষ হওয়া পর্যন্ত।
   */
  oauthToken String?


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments Shipment[]

  @@map("courier_accounts")
}

/// পার্সেল — এক অর্ডার কুরিয়ারে গেলে একটা `Shipment` তৈরি হয়।
///
/// **অর্ডার আর পার্সেল আলাদা রাখা হয়** কারণ একটা অর্ডার ফেরত এসে
/// আবার পাঠানো হতে পারে — তখন দুটো পার্সেল, একই অর্ডার। `Order`-এ
/// ট্র্যাকিং নম্বর রাখলে দ্বিতীয়বারে প্রথমটার হিসাব হারিয়ে যেত।
model Shipment {
  id      String @id @default(cuid())
  orderId String

  courierAccountId String
  courier          CourierKind

  /**
   * কুরিয়ারের দেওয়া আইডি। `null` = এখনো পাঠানো হয়নি বা `MANUAL`।
   *
   * `@unique` নয়: দুই কুরিয়ারের নম্বর মিলে যেতে পারে, আর তখন
   * দ্বিতীয় পার্সেল তৈরিই হতো না। মিল ঠেকাতে
   * `@@unique([courier, consignmentId])` ব্যবহার হয়।
   */
  consignmentId String?

  /// ক্রেতাকে দেখানোর নম্বর — কুরিয়ারের সাইটে এটা দিয়ে খোঁজে
  trackingCode String?

  status ShipmentStatus @default(PENDING)

  /// কুরিয়ারের নিজের ভাষার অবস্থা — map করার আগের কাঁচা মান
  rawStatus String?

  /// COD-তে কুরিয়ার কত টাকা তুলবে, paisa। `0` = আগেই পেমেন্ট হয়ে গেছে
  codAmountPaisa Int @default(0)

  /// কুরিয়ারের চার্জ, paisa — বিল মেলানোর জন্য
  courierFeePaisa Int?

  /// কেন ফেরত এলো — অ্যাডমিনের জানা দরকার, আর ঝুঁকির হিসাবেও লাগবে
  failureReason String?

  /**
   * কুরিয়ারে পাঠানোর শেষ চেষ্টার ত্রুটি।
   *
   * রাখা হয় কারণ ব্যর্থতাটা সাধারণত key বা ঠিকানার সমস্যা, আর
   * অ্যাডমিন সেটা না দেখলে শুধু "কাজ করছে না" বলতে পারত।
   */
  lastError String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dispatchedAt DateTime?
  deliveredAt  DateTime?

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  account CourierAccount @relation(fields: [courierAccountId], references: [id])
  events  ShipmentEvent[]

  /// একই কুরিয়ারে একই নম্বর দুবার নয় — duplicate webhook-এর রক্ষা
  @@unique([courier, consignmentId])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("shipments")
}

/// পার্সেলের ইতিহাস — কুরিয়ার যা যা জানাল।
///
/// **আলাদা টেবিল, `Shipment.status` ছাড়াও:** শুধু শেষ অবস্থা রাখলে
/// "কখন পিকআপ হলো, কখন ট্রানজিটে গেল" হারিয়ে যেত, আর দেরির
/// অভিযোগে কুরিয়ারকে কিছু দেখানো যেত না।
model ShipmentEvent {
  id         String @id @default(cuid())
  shipmentId String

  status    ShipmentStatus
  /// কুরিয়ারের কাঁচা মান — map না মিললেও তথ্যটা থাকে
  rawStatus String?
  note      String?

  /// কুরিয়ার কখন ঘটনাটা ঘটেছে বলল — আমাদের `createdAt` থেকে আলাদা
  occurredAt DateTime?
  createdAt  DateTime  @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  /**
   * **একই ঘটনা দুবার নয়।** কুরিয়ার webhook প্রায়ই দুবার পাঠায়
   * (retry), আর প্রতিবার নতুন row লিখলে ইতিহাস পড়া যেত না।
   */
  @@unique([shipmentId, status, occurredAt])
  @@index([shipmentId, createdAt])
  @@map("shipment_events")
}
