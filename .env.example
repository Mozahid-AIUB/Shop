# এই ফাইলটা কপি করে `.env` বানাও — `.env` কখনো কমিট হবে না
# cp .env.example .env

# Docker service-এর জন্য `localhost` নয়, `127.0.0.1` লেখো।
# Windows-এ localhost আগে ::1 (IPv6)-এ resolve হয় আর Docker-এর IPv6 forward timeout করে।

# ---------- Database ----------
# port 5433 — 5432 নয়। host-এ আলাদা PostgreSQL ইনস্টল থাকলে সেটা 5432 দখল করে রাখে,
# তাই docker-compose এই প্রজেক্টের Postgres 5433-এ map করে।
DATABASE_URL="postgresql://tshirt:tshirt@127.0.0.1:5433/tshirt_db?schema=public"

# ---------- Redis (BullMQ) ----------
REDIS_URL="redis://127.0.0.1:6379"

# ---------- Auth ----------
# production-এ অবশ্যই বদলাও: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-access-secret-change-in-production"
# refresh token JWT নয় — কাঁচা random string, DB-তে শুধু sha256 hash থাকে।
# তাই সই করার আলাদা secret লাগে না (দেখো: auth/token.service.ts)
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# প্রথম Super Admin — `npm run db:seed` এই দুটো না পেলে চলবে না।
# পাসওয়ার্ড অন্তত ১২ অক্ষর। production-এ আলাদা রাখো।
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Super Admin"

# ---------- Object storage (MinIO local / S3 prod) ----------
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="tshirt-designs"

# ---------- Logging ----------
# trace | debug | info | warn | error — না দিলে dev-এ debug, production-এ info
LOG_LEVEL=""
# log পুরোপুরি বন্ধ। টেস্ট নিজে বসায়, হাতে দেওয়ার দরকার নেই
LOG_SILENT=""

# ---------- Rate limit ----------
# "true" দিলে সীমা কার্যত তুলে নেওয়া হয়। **production-এ কখনো নয়** —
# এটা শুধু টেস্টের জন্য, যেখানে ইচ্ছাকৃতভাবে বারবার লগইনের চেষ্টা হয়
THROTTLE_DISABLED=""

# ---------- Fraud guard (COD ঝুঁকি) ----------
# "বড় অর্ডার" কত টাকা থেকে — **paisa-তে**। ৫০০০ টাকা = 500000
# নতুন অ্যাকাউন্ট থেকে এর বেশি অঙ্কের COD এলে ঝুঁকির স্কোর বাড়ে।
# দোকানভেদে গড় অর্ডার আলাদা, তাই নিজের মতো বসাও। না দিলে ৫০০০ টাকা।
# মনে রাখো: স্কোর কখনো অর্ডার আটকায় না, শুধু অ্যাডমিনকে দেখতে বলে।
FRAUD_LARGE_ORDER_PAISA=""

# ---------- App ----------
NODE_ENV="development"
API_PORT="4000"
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---------- Payment (Phase 07 — sandbox credentials) ----------
PAYMENT_PROVIDER="mock"
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_SANDBOX="true"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_SANDBOX="true"

# ---------- Notifications (Phase 10) ----------
SMS_PROVIDER="mock"
SMS_API_KEY=""
SMS_SENDER_ID=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="noreply@example.com"
